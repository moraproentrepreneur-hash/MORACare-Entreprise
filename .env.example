# MORACare Enterprise — variables d'environnement
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs de votre projet
# Supabase (Project Settings › API). `.env.local` est ignoré par git : aucune
# clé réelle ne doit jamais être versionnée.

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publiable (ou clé « anon »). Exposée au navigateur : elle ne donne accès
# qu'à ce que les politiques RLS autorisent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publiable

# Clé secrète (ou « service_role ») — CONTOURNE TOUTES LES POLITIQUES RLS.
# Strictement côté serveur : ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-secrete

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MORACare

# ---------------------------------------------------------------------------
# Variables utilisées uniquement par les scripts d'administration
# ---------------------------------------------------------------------------

# Jeton d'accès personnel Supabase, pour `npm run db:migrate` et la génération
# des types. Donne accès à l'ensemble du compte : à traiter comme un secret.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# Création du compte Super Admin (`npm run seed:superadmin`)
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
