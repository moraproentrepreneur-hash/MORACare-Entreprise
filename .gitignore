# MORACare Enterprise - .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
out/
dist/
build/

# ---------------------------------------------------------------------------
# SECRETS — ne doivent JAMAIS être versionnés
# ---------------------------------------------------------------------------

# Variables d'environnement (clés Supabase, service_role)
.env
.env.*
!.env.example

# Identifiants générés localement (mot de passe Super Admin)
*.local
!*.config.local.js

# Clés et certificats
*.pem
*.key
*.p12
*.pfx

# Jetons d'accès Supabase / CLI
.supabase/
supabase/.temp/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tests
coverage/
.vitest/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
